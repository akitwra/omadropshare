[Unit]
Description=OmarchyDrop user daemon
Documentation=https://github.com/akitwra/omadropshare
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/omdropd
Restart=on-failure
RestartSec=3

# The user daemon needs its Unix socket, IPv6 AirDrop transport, netlink
# notifications, Downloads, and the system D-Bus. It does not need raw-radio
# capabilities; those belong to the separately reviewed radio service.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=default.target

